---
import sinfoniaLogo from '../assets/sinfonia.svg';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="landing-page">
		<div class="logo-stage">
			<img src={sinfoniaLogo.src} alt="SINFONiA" />
		</div>
	</main>
</Layout>

<style>
	.landing-page {
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		background: white;
	}

	.logo-stage {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(92vw, 1200px);
		transform: translate(-50%, -50%);
		will-change: top, width, transform;
		animation: settle-logo 0.8s cubic-bezier(0.7, 0, 0.25, 1) 0.6s forwards;
	}

	.logo-stage img {
		display: block;
		width: 100%;
		height: auto;
	}

	@keyframes settle-logo {
		from {
			top: 50%;
			width: min(92vw, 1200px);
			transform: translate(-50%, -50%);
		}
		to {
			top: 1.25rem;
			width: clamp(132px, 18vw, 168px);
			transform: translate(-50%, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-stage {
			top: 1.25rem;
			width: clamp(132px, 18vw, 168px);
			transform: translate(-50%, 0);
			animation: none;
		}
	}
</style>
